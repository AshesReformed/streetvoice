# Copy this file to .env.local and fill in the values. Never commit .env.local.

# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Bypasses Row-Level Security, so never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Call webhook ---
# Shared secret sent as the x-webhook-secret header to /api/calls/webhook.
# Required in production; generate one with: openssl rand -hex 32
WEBHOOK_SECRET=

# --- AI providers ---
# gemini = one Gemini call does transcript, translation and routing (recommended)
# staged = the ASR / translation / keyword chain configured below
AI_PROVIDER=gemini
# Free key: https://aistudio.google.com -> Get API key
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# Tried in order when the main model is overloaded or rate-limited (comma-separated)
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash,gemini-3.6-flash,gemini-3.5-flash-lite

# Used only when AI_PROVIDER=staged:
# mock = canned demo output, whisper / nllb = self-hosted models (local only, needs several GB of RAM)
ASR_PROVIDER=mock
TRANSLATION_PROVIDER=mock
# Optional model overrides for the self-hosted providers
# WHISPER_MODEL=Xenova/whisper-small
# NLLB_MODEL=Xenova/nllb-200-distilled-600M

# --- SMS to citizens and departments ---
# mock = log messages instead of sending; android = send through the
# "SMS Gateway for Android" app (https://sms-gate.app) on a phone with a SIM
SMS_PROVIDER=mock
# From the app's Cloud Server section (android provider only)
# SMS_GATEWAY_USERNAME=
# SMS_GATEWAY_PASSWORD=
# SMS_GATEWAY_URL=https://api.sms-gate.app/3rdparty/v1
# The app's webhook signing key (Settings > Webhooks); required in production
# SMS_WEBHOOK_SIGNING_KEY=
# Public address of this app, used in links sent by SMS
PUBLIC_BASE_URL=http://localhost:3000
# Secret for hashing callers' phone numbers (defaults to the service-role key)
# PHONE_HASH_SECRET=

# --- Spam guard (optional; defaults shown) ---
# Complaints one number may file per hour / per day
# SPAM_MAX_CALLS_PER_HOUR=4
# SPAM_MAX_CALLS_PER_DAY=15
# Browser-simulator calls one IP may make per 10 minutes (a venue's Wi-Fi is one IP)
# SPAM_MAX_CALLS_PER_IP=20
# Spam-labelled calls in 7 days that block a number automatically, and for how long
# SPAM_AUTO_BLOCK_AFTER=2
# SPAM_AUTO_BLOCK_HOURS=24

# --- Twilio (optional, only for a real phone number) ---
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=

# --- Demo accounts created by `npm run seed:officers` ---
# At least 8 characters. They are never stored in the repo.
SEED_ADMIN_PASSWORD=
SEED_OFFICER_PASSWORD=
